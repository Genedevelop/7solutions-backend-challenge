# Server
HTTP_ADDR=:8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=user_api

# JWT (the server refuses to start until this is replaced with at least 32 random bytes: openssl rand -hex 32)
JWT_SECRET=change-me
JWT_ISSUER=user-api
JWT_TTL=1h

# Background job
USER_COUNT_INTERVAL=10s
